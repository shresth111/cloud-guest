[Unit]
Description=CloudGuest config-push agent (SSH bridge for the dashboard)
After=network.target

[Service]
Type=simple
Environment=CONFIG_AGENT_SECRET=__REDACTED_SEE_README__
ExecStart=/usr/bin/python3 /usr/local/sbin/config_agent.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
