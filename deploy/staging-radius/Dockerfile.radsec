# STAGING ONLY. The RadSec (RADIUS over TLS, TCP 2083) half of the staging
# RADIUS hub. A separate container from the UDP one (Dockerfile) because it
# needs FreeRADIUS >= 3.2.7: on 3.2.1 / 3.2.3 / 3.2.5 a TLS listener with
# `check_client_connections = yes` authorizes the connection and then never
# answers the first request on it (measured 2026-10-03, see
# ~/wyfy-ops/aruba-ap21/STAGING_RADSEC.md). The UDP container stays on 3.2.1
# to match the prod hub; this one never touches UDP 1812/1813.
# Build context: the repo root (see docker-compose.yml).
FROM freeradius/freeradius-server:3.2.8 AS stock

FROM python:3.12-slim AS gen
COPY --from=stock /etc/freeradius/sites-available/default /gen/stock-default
COPY backend/ops/freeradius/rest.conf                     /gen/rest.conf
COPY backend/ops/freeradius/sites-default.snippets.conf   /gen/snippets.conf
COPY deploy/staging-radius/gen_site.py                    /gen/gen_site.py
RUN python3 /gen/gen_site.py /gen radsec

FROM freeradius/freeradius-server:3.2.8
COPY --from=gen /gen/out/radsec  /etc/freeradius/sites-available/radsec
COPY --from=gen /gen/out/rest    /etc/freeradius/mods-available/rest
COPY deploy/staging-radius/radsec/listen-radsec.conf /etc/freeradius/sites-available/listen-radsec
COPY deploy/staging-radius/radsec/wyfy_radsec.mods   /etc/freeradius/mods-available/wyfy_radsec
COPY deploy/staging-radius/radsec/wyfy_radsec.policy /etc/freeradius/policy.d/wyfy_radsec
COPY deploy/staging-radius/radsec/entrypoint-radsec.sh /opt/wyfy/entrypoint-radsec.sh
# Only the RadSec site + inner-tunnel (the stock eap module needs it) with its
# 127.0.0.1:18120 listener removed -- the UDP container on the same host
# network already owns that port. So: no UDP listeners at all here, and no
# localhost/testing123 client is reachable.
RUN rm -f /etc/freeradius/sites-enabled/* \
 && sed -i '/^listen {/,/^}/d' /etc/freeradius/sites-available/inner-tunnel \
 && ! grep -q '^listen' /etc/freeradius/sites-available/inner-tunnel \
 && ln -s ../sites-available/inner-tunnel  /etc/freeradius/sites-enabled/inner-tunnel \
 && ln -s ../sites-available/radsec        /etc/freeradius/sites-enabled/radsec \
 && ln -s ../sites-available/listen-radsec /etc/freeradius/sites-enabled/listen-radsec \
 && ln -sf ../mods-available/rest        /etc/freeradius/mods-enabled/rest \
 && ln -s  ../mods-available/wyfy_radsec /etc/freeradius/mods-enabled/wyfy_radsec \
 && mkdir -p /var/lib/wyfy-radsec /etc/wyfy-radsec \
 && chmod 0755 /opt/wyfy/entrypoint-radsec.sh
ENV WYFY_RADIUS_API_URI=http://127.0.0.1:8000/api/v1 RADSEC_TLS_MAX=1.2
ENTRYPOINT ["/opt/wyfy/entrypoint-radsec.sh"]
